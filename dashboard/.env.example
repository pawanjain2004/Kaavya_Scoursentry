# Copy to .env for local use:
#   cp .env.example .env
#
# On Vercel: Project → Settings → Environment Variables
# Add the same keys (Production + Preview).
#
# NOTE: These values still end up in the browser after deploy.
# .env only keeps them out of GitHub.

FIREBASE_API_KEY=YOUR_API_KEY
FIREBASE_AUTH_DOMAIN=YOUR-PROJECT.firebaseapp.com
FIREBASE_DATABASE_URL=https://YOUR-PROJECT-default-rtdb.asia-southeast1.firebasedatabase.app
FIREBASE_PROJECT_ID=YOUR-PROJECT
FIREBASE_STORAGE_BUCKET=YOUR-PROJECT.appspot.com
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
FIREBASE_MEASUREMENT_ID=

DEVICE_ID=pier-01
HISTORY_POINTS=360
OFFLINE_AFTER_MS=15000
